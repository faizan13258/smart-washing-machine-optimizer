{
    "model": "Multi-output Artificial Neural Network",
    "library": "scikit-learn MLPRegressor",
    "architecture": [
        64,
        32
    ],
    "activation": "relu",
    "optimizer": "adam",
    "random_state": 42,
    "training_rows": 7000,
    "validation_rows": 1500,
    "test_rows": 1500,
    "input_features": [
        "dirt_level",
        "load_kg",
        "fabric_type",
        "water_availability"
    ],
    "output_targets": [
        "wash_time_min",
        "water_consumption_l",
        "detergent_ml",
        "spin_speed_rpm"
    ],
    "target_data_note": "Targets are simulated using documented deterministic rules. They are not real washing-machine measurements."
}